node_modules/
dist/
coverage/
*.tsbuildinfo

# 运行时数据根（默认与程序同层，见 docs/11 的设计沿用）
data/
*.log
# nohup 后台启动 daemon 时落在仓库根的日志
nohup.out

.DS_Store
.env
.env.local

# Python 字节码缓存（插件被宿主拉起时生成）
__pycache__/
*.pyc

# 插件运行时依赖（21MB，可重建：见 requirements.lock 头注释）
plugins/streamget-plugin/site-packages/

# 层 B 平台相关二进制（ffmpeg / python），由 tools/fetch-ffmpeg.sh 或打包脚本生成
vendor/

# 本地工具状态（WorkBuddy 会话记忆等），不入库
.workbuddy/
