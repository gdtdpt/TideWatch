{
  "name": "tidewatch-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TideWatch daemon — multi-platform live-stream recorder (headless service + web UI)",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @tidewatch/server dev",
    "dev:ui": "pnpm --filter @tidewatch/ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fetch:ffmpeg": "bash tools/fetch-ffmpeg.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
